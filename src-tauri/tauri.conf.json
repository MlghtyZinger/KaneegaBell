{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Emu Frontend",
  "version": "0.1.0",
  "identifier": "com.sultanmatoo.emufrontend",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Emu Frontend",
        "width": 1600,
        "height": 900,
        "minWidth": 960,
        "minHeight": 540,
        "backgroundColor": "#0e1014"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' thumb: http://thumb.localhost https://thumbnails.libretro.com https://art.gametdb.com data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
